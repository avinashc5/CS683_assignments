#include "cache.h"

#define maxRRPV 3
uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize IRRIP state for L2C" << endl;

    for (int i = 0; i < L2C_SET; i++){
        for (int j = 0; j < L2C_WAY; j++){
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // A small improvement can be to find out all the ones with rrpv = 3 and then return the one which is data and not instruction. are those 2 distinguishable tho?
    while (1)
    {
        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	    TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	    TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	    TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);


    /*
        POLICY
        Insertion: For instructions, insert at 0. For non-instructions, insert at 2
        Promotion: For instructions, promote to 0. For non-instructions, promote to rrpv - 1
        Eviction: Evict the first line that you find with maxRRPV
    */

    if (hit){
        if (isInstruction){
            l2_rrpv[set][way] = 0;
        }
        else {
            if (l2_rrpv[set][way] > 0)
                l2_rrpv[set][way]--;
        }
    }
    else if (isInstruction)
        l2_rrpv[set][way] = 0;
    else
        l2_rrpv[set][way] = maxRRPV - 1;
}

