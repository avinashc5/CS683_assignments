#include "cache.h"

#define maxRRPV 3
uint32_t l2_rrpv[L2C_SET][L2C_WAY];

/*
    I-RRIP POLICY (configuration s2_i1_d3_p1_a0 from replacement/irrip_policies.l2c_repl)
    Insertion: instruction lines at RRPV 1, data lines at RRPV 3 (maxRRPV)
    Promotion: instruction lines to RRPV 0, data lines decrement RRPV by 1
    Eviction:  among lines at maxRRPV, evict a data line before an instruction line;
               aging is the same as SRRIP
*/

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize IRRIP state for L2C" << endl;

    for (int i = 0; i < L2C_SET; i++){
        for (int j = 0; j < L2C_WAY; j++){
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

// find replacement victim
// current_set[i].instruction is set by fill_cache (src/cache.cc) for L2C lines filled by instruction loads/prefetches
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    while (1)
    {
        // first look for a data line at maxRRPV
        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction)
                return i;

        // only instruction lines are at maxRRPV (if any)
        for (int i = 0; i < L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        // no line at maxRRPV, age the set
        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	    TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	    TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	    TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    if (hit){ // promotion
        if (isInstruction)
            l2_rrpv[set][way] = 0;
        else if (l2_rrpv[set][way] > 0)
            l2_rrpv[set][way]--;
    }
    else { // insertion
        if (isInstruction)
            l2_rrpv[set][way] = 1;
        else
            l2_rrpv[set][way] = maxRRPV;
    }
}

